# Skupni skrivni ključ med spletno aplikacijo in lokalnim mostom.
# Generiraj npr. z: openssl rand -hex 24
BRIDGE_TOKEN=

# Javni HTTPS naslov mostu (Cloudflare Tunnel, Tailscale, VPN...).
# Primer: https://smarthome-bridge.tvoja-domena.si
BRIDGE_URL=

# PIN za odklep javne nadzorne plošče (opcijsko, lahko nastaviš tudi v aplikaciji)
APP_PIN=
